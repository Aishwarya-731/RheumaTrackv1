{
  "name": "rheumatrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RheumaTrack \u2014 multi-joint mobility monitoring and symptom-assessment platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "concurrently -k -n emu,web -c magenta,cyan \"npm:emulators\" \"npm:dev:emu\"",
    "dev:emu": "cross-env VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --project demo-rheumatrack",
    "seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seed-emulator.ts",
    "grant-clinician": "tsx scripts/grant-clinician.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rheumatrack \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test --project=emulator",
    "test:e2e:install": "playwright install chromium",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "emulators:persist": "firebase emulators:start --project demo-rheumatrack --import=./.emulator-data --export-on-exit=./.emulator-data",
    "test:e2e:harness": "playwright test --project=harness",
    "build:harness": "cross-env VITE_TEST_HARNESS=memory vite build --outDir dist-harness",
    "golden": "python3 reference/python/rt_analysis.py --write-expected reference/golden",
    "test:all": "npm run typecheck && npm test && npm run build",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "papaparse": "^5.7.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
